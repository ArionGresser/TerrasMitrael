# Dependências instaladas pelo npm (recriadas com "npm install")
/node_modules

# Arquivos gerados pelo Next.js durante o desenvolvimento e o build
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Variáveis de ambiente e segredos
.env
.env*.local

# Sistema operacional e editores
.DS_Store
*.pem
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Netlify
.netlify/

# Configuração local de ferramentas, não faz parte do site
.claude/

# Kit do mapa por partes (gerado por scripts/mapa/recortar-continentes.py)
/mapa-kit/

# O projeto usa o npm (package-lock.json)
pnpm-lock.yaml
/sons-kit/
/video/node_modules/
/video/tmp/
/video/public/
/video/out/

# Cache do Python, gerado ao rodar os scripts
__pycache__/
